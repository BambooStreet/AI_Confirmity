generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Participant {
  id          String    @id @default(cuid())
  condition   String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  consent     Boolean   @default(false)
  currentStep Int       @default(0)
  responses   Response[]
  comments    Comment[]
}

model Response {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id])
  surveyType    String
  questionId    String
  answer        String
  createdAt     DateTime    @default(now())
}

model Comment {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id])
  content       String
  createdAt     DateTime    @default(now())
}

// 설문 문항 정의를 type("pre" | "post")별로 JSON 배열로 보관.
// 코드의 정적 기본값(survey-questions.ts)을 시드로 쓰고, admin에서 편집 시 이 행을 갱신한다.
model SurveyConfig {
  type      String   @id // "pre" | "post"
  questions Json
  updatedAt DateTime @updatedAt
}
