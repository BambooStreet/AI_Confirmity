generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Participant {
  id           String    @id @default(cuid())
  condition    String
  // 외부 패널(CloudResearch 등) 참가자 식별자 — 진입 URL 쿼리에서 추출. 재진입 시 중복 생성 방지용 unique.
  externalId   String?   @unique
  // 진입 URL 쿼리스트링 전체 (플랫폼·설정에 따라 키 이름이 달라질 수 있어 통째로 보존)
  externalMeta Json?
  // 실험 단계: "test"(내부 테스트) | "pilot" | "main"(본실험). 생성 시점의 전역 설정값이 기록된다.
  // default "test" — 기존 데이터 백필 겸, 설정을 깜빡해도 본실험 데이터가 오염되지 않는 안전한 기본값.
  phase        String    @default("test")
  // 참가자 경험 언어: "ko"(기본) | "en". 진입 URL의 lang 파라미터로 결정되어 생성 시 고정된다.
  language     String    @default("ko")
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  consent      Boolean   @default(false)
  currentStep  Int       @default(0)
  responses    Response[]
  comments     Comment[]
}

// 전역 키-값 설정 (예: currentPhase — 새 참가자에게 찍히는 현재 실험 단계)
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Response {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id])
  surveyType    String
  questionId    String
  answer        String
  createdAt     DateTime    @default(now())
}

model Comment {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id])
  content       String
  createdAt     DateTime    @default(now())
}

// 설문 문항 정의를 type("pre" | "post")별로 JSON 배열로 보관.
// 코드의 정적 기본값(survey-questions.ts)을 시드로 쓰고, admin에서 편집 시 이 행을 갱신한다.
model SurveyConfig {
  type      String   @id // "pre" | "post"
  questions Json
  updatedAt DateTime @updatedAt
}
